# Cloudflare Pages headers (copied to out/ on build).
# The site is a fully static export, so these are set at the edge.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # img-src is restricted to 'self' + data: on purpose: every image is a local
  # WebP (site/lib/images.ts rewrites scraped URLs to local assets), so the
  # old `https:` wildcard only allowed a compromised upstream to beacon
  # visitors with a tracking pixel. `data:` is still needed for the inline
  # placeholder SVG in globals.css.
  # script-src-attr 'none' blocks inline event handlers (onerror=, onclick=);
  # React never emits them, and they are a classic XSS execution sink.
  # SCRIPTS: no script-src/default-src here ON PURPOSE — scripts are governed
  # by the per-page <meta> CSP that scripts/csp-hashes.mjs injects at build
  # time ('self' + exact sha256 hashes of each page's inline hydration/flight
  # scripts). A static header cannot enumerate per-page hashes, and adding
  # script-src/default-src here would INTERSECT with the meta policy and
  # block the hashed scripts. 'unsafe-inline' for scripts is gone.
  # style-src keeps 'unsafe-inline': React style attributes and the inlined
  # stylesheet require it (css-url.ts escapes every dynamic url() value).
  Content-Security-Policy: style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com; worker-src 'self'; child-src 'self'; media-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'; script-src-attr 'none'; upgrade-insecure-requests

# Content-hashed, immutable assets - safe to cache forever
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/search-index/*
  Cache-Control: public, max-age=31536000, immutable

/banners/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.html
  Cache-Control: public, max-age=0, must-revalidate
